/* minimal-test branch: full layer set + hold-tap behaviors + combos, synced
 * to wireless-corne-zmk-config's current keymap (hml/hmr tuning, outer-thumb
 * backspace/enter, win/mac combo variants -- see blecorne.keymap). Still no
 * ZMK Studio (studio_unlock -> trans below), no GATT sync.
 *
 * Position numbering follows the `map` order in klor.dtsi's default_transform:
 *   row0:  0-9    (5 left, 5 right)
 *   row1:  10-19  (5 left, 5 right)
 *   row2:  20-24 left, 25-26 inner media keys, 27-31 right
 *   thumb: 32-34 left, 35-37 right
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define KEYS_L  0  1  2  3  4  10 11 12 13 14 20 21 22 23 24
#define KEYS_R  5  6  7  8  9  15 16 17 18 19 27 28 29 30 31
#define THUMBS  32 33 34 35 36 37

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        /* Thumb shift/key: tap = key, hold = modifier, tap-then-hold = repeat key */
        thm: thm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        /* 3-second hold before &bootloader fires; a quick tap does nothing.
         * Bound at two positions in bootloader_layer (Q and `;`) -- each
         * tracks its own hold/tap state independently, same as hml/hmr/thm
         * already being reused across many positions above. hold-preferred
         * (not balanced) so nothing can resolve this early via another
         * key's interrupt-release; not that anything else should be
         * pressed during this hold anyway. */
        bootloader_hold: bootloader_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "hold-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bootloader>, <&none>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        /* Holding NUM (mo 4) + FUNC (mo 7) simultaneously activates ADMIN (8).
         * Costs no dedicated thumb. Mac toggle in ADMIN resets on power cycle —
         * keyboard always boots in Windows mode, which is intended.
         *
         * ADMIN (then-layer) must be numbered higher than every layer in
         * if-layers -- see admin_layer's comment in the keymap block for why. */

        admin {
            if-layers = <4 7>;
            then-layer = <8>;
        };

        /* Holding NUM (mo 4) + NAV (lt 5, via Z) "arms" V (position 24) with
         * &mo 10 -- see arm_layer's comment. Releasing Num/Nav afterward does
         * NOT drop this: ZMK resolves a key's binding once, at its own
         * press, from whatever layers were active at that instant (see
         * zmk_keymap_position_state_changed's zmk_keymap_active_behavior_layer
         * snapshot in zmk's keymap.c) -- so once V is pressed while this
         * layer is active, V's own hold keeps layer 10 open independent of
         * Num/Nav's state afterward. */

        arm {
            if-layers = <4 5>;
            then-layer = <9>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Positions reference layer 0. No 'layers' restriction — combos fire in
         * all contexts (base, MAC overlay, and utility layers). */
        /* Non-adjacent combos — lower roll risk, no prior-idle guard needed */

        combo_tab {
            timeout-ms = <40>;
            key-positions = <0 1>;
            bindings = <&kp TAB>;
        };

        combo_ret {
            timeout-ms = <40>;
            key-positions = <0 3>;
            bindings = <&kp RET>;
        };

        combo_esc {
            timeout-ms = <40>;
            key-positions = <10 13>;
            bindings = <&kp ESC>;
        };

        combo_sqt {
            timeout-ms = <40>;
            key-positions = <18 19>;
            bindings = <&kp SQT>;
        };

        /* Adjacent/roll-prone combos — require-prior-idle-ms 150 gates fast typing
         * rolls. If misfires persist, raise timeout-ms (primary tuning knob).
         *
         * Win/Mac split: base profile layer (0 Colemak-Win, 2 Qwerty-Win vs
         * 1 Colemak-Mac, 3 Qwerty-Mac) stays active underneath any stacked momentary layer
         * (NUM/NAV/SYM/FUNC/ADMIN), so restricting by base layer here still
         * fires correctly while those are held. */

        combo_undo {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 34>;
            layers = <0 2>;
            bindings = <&kp LC(Z)>;
        };

        combo_undo_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 34>;
            layers = <1 3>;
            bindings = <&kp LG(Z)>;
        };

        combo_cut {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 21>;
            layers = <0 2>;
            bindings = <&kp LC(X)>;
        };

        combo_cut_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 21>;
            layers = <1 3>;
            bindings = <&kp LG(X)>;
        };

        combo_copy {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <21 22>;
            layers = <0 2>;
            bindings = <&kp LC(C)>;
        };

        combo_copy_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <21 22>;
            layers = <1 3>;
            bindings = <&kp LG(C)>;
        };

        combo_paste {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <22 23>;
            layers = <0 2>;
            bindings = <&kp LC(V)>;
        };

        combo_paste_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <22 23>;
            layers = <1 3>;
            bindings = <&kp LG(V)>;
        };

        /* Both shift thumbs simultaneously → Caps Word */
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* COLEMAK-DH WIN — default/base layer (layer 0), Windows homerow mods (GACS).
         * Layout: Q W F P B | J L U Y ;
         *         A R S T G | M N E I O
         *         Z X C D V | K H , . /
         * Always boots here; the other three variants are &tog'd on top from ADMIN. */

        colemak_win_layer {
            label = "Colemak-DH (Win)";
            bindings = <
&kp Q         &kp W        &kp F        &kp P  &kp B             &kp J            &kp L  &kp U        &kp Y        &kp SEMI
&hml LCTRL A  &hml LGUI R  &hml LALT S  &kp T  &kp G             &kp M            &kp N  &hmr RALT E  &hmr RGUI I  &hmr RCTRL O
&lt 5 Z       &kp X        &kp C        &kp D  &kp V  &trans     &trans    &kp K  &kp H  &kp COMMA    &kp DOT      &lt 6 FSLH
                          &kp BSPC     &mo 4  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 7  &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* COLEMAK-DH MAC — full base layer with macOS homerow mods (Ctrl↔GUI swapped).
         * Activated via &tog 1 from ADMIN. &tog state is runtime-only (not written
         * to NVS), so this layer is always off on power cycle. */

        colemak_mac_layer {
            label = "Colemak-DH (Mac)";
            bindings = <
&kp Q         &kp W        &kp F        &kp P  &kp B             &kp J            &kp L  &kp U         &kp Y        &kp SEMI
&hml LGUI A   &hml LCTRL R &hml LALT S  &kp T  &kp G             &kp M            &kp N  &hmr RALT E   &hmr RCTRL I &hmr RGUI O
&lt 5 Z       &kp X        &kp C        &kp D  &kp V  &trans     &trans    &kp K  &kp H  &kp COMMA     &kp DOT      &lt 6 FSLH
                          &kp BSPC     &mo 4  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 7  &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* QWERTY WIN — full base layer with Windows homerow mods (GACS).
         * Activated via &tog 2 from ADMIN. */

        qwerty_win_layer {
            label = "Qwerty (Win)";
            bindings = <
&kp Q         &kp W        &kp E        &kp R  &kp T             &kp Y            &kp U  &kp I        &kp O        &kp P
&hml LCTRL A  &hml LGUI S  &hml LALT D  &kp F  &kp G             &kp H            &kp J  &hmr RALT K  &hmr RGUI L  &hmr RCTRL SEMI
&lt 5 Z       &kp X        &kp C        &kp V  &kp B  &kp C_MUTE &kp C_PP  &kp N  &kp M  &kp COMMA    &kp DOT      &lt 6 FSLH
                          &kp BSPC     &mo 4  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 7  &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* QWERTY MAC — full base layer with macOS homerow mods (Ctrl↔GUI swapped on A/S
         * and L/SEMI only; D and K keep the same mod both ways). Spelled out in full
         * (not `trans`-overlaid on qwerty_win) since layer 0 is Colemak now, not Qwerty —
         * `trans` here would fall through to Colemak letters otherwise.
         * Activated via &tog 3 from ADMIN. */

        qwerty_mac_layer {
            label = "Qwerty (Mac)";
            bindings = <
&kp Q         &kp W        &kp E        &kp R  &kp T             &kp Y            &kp U  &kp I        &kp O        &kp P
&hml LGUI A   &hml LCTRL S &hml LALT D  &kp F  &kp G             &kp H            &kp J  &hmr RALT K  &hmr RCTRL L &hmr RGUI SEMI
&lt 5 Z       &kp X        &kp C        &kp V  &kp B  &kp C_MUTE &kp C_PP  &kp N  &kp M  &kp COMMA    &kp DOT      &lt 6 FSLH
                          &kp BSPC     &mo 4  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 7  &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* NUM — left: 1-5 top row, 6-0 homerow; right: &trans */

        num_layer {
            label = "Numbers";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5             &trans  &trans  &trans  &trans  &trans
&kp NUMBER_6  &kp N7        &kp N8        &kp NUMBER_9  &kp NUMBER_0       &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans             &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* NAV — right homerow: hjkl arrows; right top: home/pgup/pgdn/end;
         * right bottom: Ctrl+Left/Right word motions; left: del + vol */

        nav_layer {
            label = "Navigation";
            bindings = <
&trans  &trans  &trans      &trans        &trans        &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &trans  &trans      &kp C_VOL_DN  &kp C_VOL_UP  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &kp BSPC &kp DELETE &trans        &trans  &trans  &trans  &trans         &trans       &trans     &trans  &trans
                            &trans        &trans        &trans    &trans         &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            label = "Symbols";
            bindings = <
&kp MINUS      &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE             &trans  &trans  &trans  &trans  &trans
&kp AMPERSAND  &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE             &trans  &trans  &trans  &trans  &trans
&kp ASTERISK   &kp SLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NON_US_BACKSLASH  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                          &trans                &trans                 &trans                &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        func_layer {
            label = "Function Keys";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans  &trans  &trans  &trans  &trans
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F12  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans   &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ADMIN — conditional: NUM(4) + FUNC(7) held simultaneously. Must be
         * the highest-numbered layer in this file: ZMK resolves each key
         * position from the highest *active* layer down, taking the first
         * non-transparent binding it finds, regardless of which layer is
         * "conditional" -- if ADMIN sat below FUNC (its own trigger), FUNC's
         * real F-key bindings at the same row0/row1 positions would always
         * win the instant the chord fires, making ADMIN's own bindings
         * unreachable. This was a real bug (not just a display quirk): the
         * OLED's "highest active layer" name display surfaced it as
         * permanently showing "Func" while holding the chord, matching what
         * was actually happening -- FUNC's bindings really were winning.
         *
         * Top row left: BT device select 0-3, BT clear.
         * Top row right: unused (sys_reset/bootloader moved to the dedicated
         * Bootloader layer -- see arm_layer/bootloader_layer below).
         * Homerow left: to 0 = back to Colemak-DH (Win) default (deactivates
         * every other active layer, including whichever &tog is on -- see
         * `&to`'s docs), tog 1 = Colemak Mac, tog 2 = Qwerty Win, tog 3 =
         * Qwerty Mac.
         * Homerow right H: studio unlock -- trans for now, no Studio this round.
         * All tog states are runtime-only — always off on power cycle (Colemak-DH Win default). */

        admin_layer {
            label = "Admin";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
&to 0         &tog 1        &tog 2        &tog 3        &trans      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans   &trans    &trans       &trans  &trans  &trans  &trans
                            &trans        &trans        &trans      &trans          &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ARM — conditional: NUM(4) + NAV(5) held simultaneously "arms" V
         * (position 24) with &mo 10. See conditional_layers's `arm` entry
         * comment for why releasing Num/Nav afterward doesn't drop this --
         * V's own hold is what keeps BOOTLOADER (layer 10) open from here on. */

        arm_layer {
            label = "Arm";
            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 10  &trans  &trans   &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* BOOTLOADER — only reachable by holding V after arming it via
         * ARM (Num+Nav), see above. Q and `;` each need an independent
         * 3-second hold (bootloader_hold, in behaviors{} above) before
         * doing anything -- a quick tap is a no-op (&none).
         *
         * &bootloader has locality = BEHAVIOR_LOCALITY_EVENT_SOURCE (ZMK's
         * app/src/behaviors/behavior_reset.c): it reboots whichever
         * physical half the triggering keypress actually originated from,
         * not always the central -- confirmed by reading ZMK's own
         * behavior.c dispatch (BEHAVIOR_LOCALITY_EVENT_SOURCE case calls
         * zmk_split_central_invoke_behavior() for non-local sources). That
         * only holds for a binding resolved directly from a real keymap
         * position, though -- combos always tag their synthesized event
         * `.source = ZMK_POSITION_STATE_CHANGE_SOURCE_LOCAL` (see zmk's
         * combo.c), which would make a combo-bound &bootloader always
         * reboot the central. Q/`;` are plain direct position bindings
         * here specifically to preserve that routing: Q (position 0,
         * always physically on the left) reboots the central; `;`
         * (position 9, always physically on the right) reboots the
         * peripheral. Hold-tap itself preserves the original event's
         * source when it fires its hold binding (behavior_hold_tap.c
         * replays `.source = hold_tap->source`), so wrapping &bootloader
         * in bootloader_hold doesn't break this.
         *
         * Reboot the right half BEFORE the left: once the central (left)
         * reboots, it stops running ZMK entirely, so the peripheral has no
         * central left to resolve anything through -- holding `;`
         * afterward does nothing. Don't hold `;` and Q at the same time
         * either: if both fire together, the central's own reboot can cut
         * its BLE radio before the "reboot yourself" message to the
         * peripheral finishes sending, leaving the right half un-rebooted
         * with no indication why. Do them strictly one at a time, right
         * first, fully confirmed, before starting Q. */

        bootloader_layer {
            label = "Bootloader";
            bindings = <
&bootloader_hold  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &bootloader_hold
&trans            &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans            &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans          &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
