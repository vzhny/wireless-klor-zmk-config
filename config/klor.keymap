/* minimal-test branch: full layer set + hold-tap behaviors + combos, synced
 * to wireless-corne-zmk-config's current keymap (hml/hmr tuning, outer-thumb
 * backspace/enter, win/mac combo variants -- see blecorne.keymap). Still no
 * ZMK Studio (studio_unlock -> trans below), no GATT sync.
 *
 * Position numbering follows the `map` order in klor.dtsi's default_transform:
 *   row0:  0-9    (5 left, 5 right)
 *   row1:  10-19  (5 left, 5 right)
 *   row2:  20-24 left, 25-26 inner media keys, 27-31 right
 *   thumb: 32-34 left, 35-37 right
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define KEYS_L  0  1  2  3  4  10 11 12 13 14 20 21 22 23 24
#define KEYS_R  5  6  7  8  9  15 16 17 18 19 27 28 29 30 31
#define THUMBS  32 33 34 35 36 37

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release; /* same-hand mod+key (Ctrl+F) works: decided on F's release */
            bindings = <&kp>, <&kp>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* Thumb shift/key: tap = key, hold = modifier, tap-then-hold = repeat key */
        thm: thm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        /* Holding NUM (mo 2) + FUNC (mo 5) simultaneously activates ADMIN (6).
         * Costs no dedicated thumb. Mac toggle in ADMIN resets on power cycle —
         * keyboard always boots in Windows mode, which is intended.
         *
         * ADMIN (then-layer) must be numbered higher than every layer in
         * if-layers -- see admin_layer's comment in the keymap block for why. */

        admin {
            if-layers = <2 5>;
            then-layer = <6>;
        };

        /* Holding NUM (mo 2) + NAV (lt 3, via Z) "arms" B (position 24) with
         * &mo 8 -- see arm_layer's comment. Releasing Num/Nav afterward does
         * NOT drop this: ZMK resolves a key's binding once, at its own
         * press, from whatever layers were active at that instant (see
         * zmk_keymap_position_state_changed's zmk_keymap_active_behavior_layer
         * snapshot in zmk's keymap.c) -- so once B is pressed while this
         * layer is active, B's own hold keeps layer 8 open independent of
         * Num/Nav's state afterward. */

        arm {
            if-layers = <2 3>;
            then-layer = <7>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Positions reference layer 0. No 'layers' restriction — combos fire in
         * all contexts (base, MAC overlay, and utility layers). */
        /* Non-adjacent combos — lower roll risk, no prior-idle guard needed */

        combo_tab {
            timeout-ms = <40>;
            key-positions = <0 1>;
            bindings = <&kp TAB>;
        };

        combo_ret {
            timeout-ms = <40>;
            key-positions = <0 3>;
            bindings = <&kp RET>;
        };

        combo_esc {
            timeout-ms = <40>;
            key-positions = <10 13>;
            bindings = <&kp ESC>;
        };

        combo_sqt {
            timeout-ms = <40>;
            key-positions = <18 19>;
            bindings = <&kp SQT>;
        };

        /* Adjacent/roll-prone combos — require-prior-idle-ms 150 gates fast typing
         * rolls. If misfires persist, raise timeout-ms (primary tuning knob).
         *
         * Win/Mac split: base profile layer (0 Qwerty-Win vs 1 Qwerty-Mac)
         * stays active underneath any stacked momentary layer
         * (NUM/NAV/SYM/FUNC/ADMIN), so restricting by base layer here still
         * fires correctly while those are held. */

        combo_undo {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 34>;
            layers = <0>;
            bindings = <&kp LC(Z)>;
        };

        combo_undo_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <20 34>;
            layers = <1>;
            bindings = <&kp LG(Z)>;
        };

        combo_cut {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <20 21>;
            layers = <0>;
            bindings = <&kp LC(X)>;
        };

        combo_cut_mac {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <20 21>;
            layers = <1>;
            bindings = <&kp LG(X)>;
        };

        combo_copy {
            timeout-ms = <60>;
            require-prior-idle-ms = <75>;
            key-positions = <21 22>;
            layers = <0>;
            bindings = <&kp LC(C)>;
        };

        combo_copy_mac {
            timeout-ms = <60>;
            require-prior-idle-ms = <75>;
            key-positions = <21 22>;
            layers = <1>;
            bindings = <&kp LG(C)>;
        };

        combo_paste {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <22 23>;
            layers = <0>;
            bindings = <&kp LC(V)>;
        };

        combo_paste_mac {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <22 23>;
            layers = <1>;
            bindings = <&kp LG(V)>;
        };

        /* Both shift thumbs simultaneously → Caps Word */
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* QWERTY WIN — default/base layer (layer 0), Windows homerow mods (GACS).
         * Always boots here; the Mac variant is &tog'd on top from ADMIN.
         * Colemak-DH removed for now (Qwerty only) -- see readme.md. */

        qwerty_win_layer {
            display-name = "Qwerty (Win)";
            bindings = <
&kp Q         &kp W        &kp E        &kp R  &kp T             &kp Y            &kp U  &kp I        &kp O        &kp P
&hml LCTRL A  &hml LGUI S  &hml LALT D  &kp F  &kp G             &kp H            &kp J  &hmr RALT K  &hmr RGUI L  &hmr RCTRL SEMI
&lt 3 Z       &kp X        &kp C        &kp V  &kp B  &kp C_MUTE &kp C_PP  &kp N  &kp M  &kp COMMA    &kp DOT      &lt 4 FSLH
                          &kp BSPC     &mo 2  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 5  &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* QWERTY MAC — full base layer with macOS homerow mods (Ctrl↔GUI swapped).
         * Activated via &tog 1 from ADMIN. &tog state is runtime-only (not written
         * to NVS), so this layer is always off on power cycle. */

        qwerty_mac_layer {
            display-name = "Qwerty (Mac)";
            bindings = <
&kp Q         &kp W        &kp E        &kp R  &kp T             &kp Y            &kp U  &kp I        &kp O        &kp P
&hml LGUI A   &hml LCTRL S &hml LALT D  &kp F  &kp G             &kp H            &kp J  &hmr RALT K  &hmr RCTRL L &hmr RGUI SEMI
&lt 3 Z       &kp X        &kp C        &kp V  &kp B  &kp C_MUTE &kp C_PP  &kp N  &kp M  &kp COMMA    &kp DOT      &lt 4 FSLH
                          &kp BSPC     &mo 2  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 5  &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* NUM — left: 1-5 top row, 6-0 homerow; right: &trans */

        num_layer {
            display-name = "Numbers";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5             &trans  &trans  &trans  &trans  &trans
&kp NUMBER_6  &kp N7        &kp N8        &kp NUMBER_9  &kp NUMBER_0       &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans             &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* NAV — right homerow: hjkl arrows; right top: home/pgup/pgdn/end;
         * right bottom: Ctrl+Left/Right word motions; left: del + vol */

        nav_layer {
            display-name = "Navigation";
            bindings = <
&trans  &trans  &trans      &trans        &trans        &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &trans  &trans      &kp C_VOL_DN  &kp C_VOL_UP  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &kp BSPC &kp DELETE &trans        &trans  &trans  &trans  &trans         &trans       &trans     &trans  &trans
                            &trans        &trans        &trans    &trans         &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
&kp MINUS      &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE             &trans  &trans  &trans  &trans  &trans
&kp AMPERSAND  &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE             &trans  &trans  &trans  &trans  &trans
&kp ASTERISK   &kp SLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NON_US_BACKSLASH  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                          &trans                &trans                 &trans                &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        func_layer {
            display-name = "Function Keys";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans  &trans  &trans  &trans  &trans
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F12  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans   &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ADMIN — conditional: NUM(2) + FUNC(5) held simultaneously. Must be
         * the highest-numbered layer in this file: ZMK resolves each key
         * position from the highest *active* layer down, taking the first
         * non-transparent binding it finds, regardless of which layer is
         * "conditional" -- if ADMIN sat below FUNC (its own trigger), FUNC's
         * real F-key bindings at the same row0/row1 positions would always
         * win the instant the chord fires, making ADMIN's own bindings
         * unreachable. This was a real bug (not just a display quirk): the
         * OLED's "highest active layer" name display surfaced it as
         * permanently showing "Func" while holding the chord, matching what
         * was actually happening -- FUNC's bindings really were winning.
         *
         * Top row left: BT device select 0-3, BT clear.
         * Top row right: unused (sys_reset/bootloader moved to the dedicated
         * Bootloader layer -- see arm_layer/bootloader_layer below).
         * Homerow left: to 0 = back to Qwerty (Win) default (deactivates
         * every other active layer, including whichever &tog is on -- see
         * `&to`'s docs), tog 1 = Qwerty Mac. Colemak-DH removed for now.
         * Homerow right H: studio unlock -- trans for now, no Studio this round.
         * All tog states are runtime-only — always off on power cycle (Qwerty Win default). */

        admin_layer {
            display-name = "Admin";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
&to 0         &tog 1        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans   &trans    &trans       &trans  &trans  &trans  &trans
                            &trans        &trans        &trans      &trans          &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ARM — conditional: NUM(2) + NAV(3) held simultaneously "arms" B
         * (position 24) with &mo 8. See conditional_layers's `arm` entry
         * comment for why releasing Num/Nav afterward doesn't drop this --
         * B's own hold is what keeps BOOTLOADER (layer 8) open from here on. */

        arm_layer {
            display-name = "Arm";
            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 8  &trans  &trans   &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* BOOTLOADER — only reachable by holding B after arming it via
         * ARM (Num+Nav), see above. Q and `P` fire plain &bootloader on
         * press; the arm chord is the accidental-press guard. They must be
         * direct position bindings, not combos, to get correct per-half
         * routing on a split (see the zmk-bootloader-hold module README).
         * The module's 3-second &bootloader_hold never fired on hardware
         * (2026-10-30: warn showed, no reboot on either half, root cause
         * not found), so it is not used here.
         *
         * Q (position 0, always physically on the left) reboots the
         * central; `P` (position 9, always physically on the right)
         * reboots the peripheral -- see &bootloader's
         * BEHAVIOR_LOCALITY_EVENT_SOURCE, explained in the module.
         *
         * Reboot the right half BEFORE the left: once the central (left)
         * reboots, it stops running ZMK entirely, so the peripheral has no
         * central left to resolve anything through -- holding `P`
         * afterward does nothing. Don't hold `P` and Q at the same time
         * either: if both fire together, the central's own reboot can cut
         * its BLE radio before the "reboot yourself" message to the
         * peripheral finishes sending, leaving the right half un-rebooted
         * with no indication why. Do them strictly one at a time, right
         * first, fully confirmed, before starting Q. */

        bootloader_layer {
            display-name = "Bootloader";
            bindings = <
&bootloader  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &bootloader
&trans            &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans            &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans          &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };

    /* 1-second "BOOTLOADER" warning (klor_central_widget.c's
     * bootloader_warning_event_cb) at the same two positions. Plain
     * &bootloader reboots on press, so this only shows if the reboot does
     * not happen. `latch` matches this project's one-way display latch. */
    bootloader_warn_left: bootloader_warn_left {
        compatible = "zmk,bootloader-warn";
        layer = <8>;
        position = <0>;
        latch;
    };
    bootloader_warn_right: bootloader_warn_right {
        compatible = "zmk,bootloader-warn";
        layer = <8>;
        position = <9>;
        latch;
    };
};
